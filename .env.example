# Variables pour le formulaire de contact (envoi via l'API HTTP de Resend).
#
# En DÉVELOPPEMENT (npm run dev) : copiez ce fichier en `.env` et renseignez les valeurs.
# En PRODUCTION (Hostinger) : ne PAS mettre la clé ici. Déclarez les variables
#   dans hPanel → Sites web → votre Web App → Variables d'environnement.
#   Elles sont lues via `process.env`.

# Clé API Resend (https://resend.com/api-keys). SECRET — ne jamais committer.
RESEND_API_KEY=

# Destinataire des demandes (repli : thirionexpertise@gmail.com si non défini).
CONTACT_TO=thirionexpertise@gmail.com

# Expéditeur — doit appartenir à un domaine vérifié dans Resend.
# `contact@` est un alias de la boîte `david@`, ce qui ne gêne pas Resend :
# la vérification porte sur le domaine, pas sur une boîte particulière.
CONTACT_FROM=Thirion Expertise <contact@thirion-expertise.fr>
