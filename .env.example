# Variables pour le formulaire de contact (envoi SMTP via la boîte du domaine).
#
# En DÉVELOPPEMENT (npm run dev) : copiez ce fichier en `.env` et renseignez les valeurs.
# En PRODUCTION (Hostinger) : ne PAS mettre le mot de passe ici. Déclarez les
#   variables dans hPanel → Sites web → votre Web App →
#   Variables d'environnement. Elles sont lues via `process.env`.

# Serveur SMTP. Valeurs par défaut dans le code si non définies :
# smtp.hostinger.com sur le port 465 (TLS implicite ; 587 = STARTTLS).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465

# Identifiants de la boîte du domaine, créée dans hPanel → Emails.
# SMTP_USER doit être l'adresse complète.
SMTP_USER=contact@thirion-expertise.fr
# Mot de passe de la boîte. SECRET — ne jamais committer.
SMTP_PASS=

# Destinataire des demandes (repli : thirionexpertise@gmail.com si non défini).
CONTACT_TO=thirionexpertise@gmail.com

# Expéditeur affiché — doit correspondre à la boîte authentifiée ci-dessus,
# sinon le serveur SMTP refuse l'envoi.
CONTACT_FROM=Thirion Expertise <contact@thirion-expertise.fr>
